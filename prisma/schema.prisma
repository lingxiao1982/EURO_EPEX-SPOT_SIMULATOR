generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model SimulationRun {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  totalPnl    Float
  volatility  Float
  configJson  String
  ordersJson  String
}
